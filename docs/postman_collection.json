							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"attendancePercentage\": 85,\n    \"assignmentSubmissionRate\": 90,\n    \"quizAverage\": 78,\n    \"midtermMarks\": 82,\n    \"studyHoursPerWeek\": 15,\n    \"engagementScore\": 7,\n    \"loginFrequency\": 5,\n    \"participationScore\": 8,\n    \"stressLevel\": 4,\n    \"motivationLevel\": 8\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/predict", "host": ["{{baseUrl}}"], "path": ["api", "predict"] }
					}
				},
				{
					"name": "Get Prediction History",
